{
  "name": "tcgen",
  "version": "2.0.0",
  "description": "AI-Powered Unit, API, and Requirement Test Case Generator with MCP Support",
  "main": "src/server.ts",
  "bin": {
    "tcgen-mcp": "./bin/mcp.js"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "mcp": "tsx src/mcpServer.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "build": "tsc"
  },
  "keywords": [
    "mcp",
    "test-generator",
    "vitest",
    "api-testing",
    "ai-testing",
    "qa",
    "exceljs",
    "traceability-matrix"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "openai": "^7.34.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
